{
  "version": 9,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 2
  },
  "include": [
    "CMakePresets.json"
  ],

  "configurePresets": [
    {
      "name": "windows-base-local",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "D:/dev/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "x64-debug-local",
      "inherits": "x64-debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "D:/dev/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "x64-release-local",
      "inherits": "x64-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "D:/dev/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ]
}
